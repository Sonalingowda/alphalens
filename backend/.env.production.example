ALPHALENS_ENVIRONMENT=production
ALPHALENS_API_NAME="AlphaLens Live Prediction API"
ALPHALENS_API_HOST=0.0.0.0
ALPHALENS_API_PORT=8000
ALPHALENS_API_WORKERS=2
ALPHALENS_LOG_LEVEL=INFO
ALPHALENS_CORS_ALLOWED_ORIGINS=https://dashboard.example.com
ALPHALENS_MARKET_DATA_BASE_URL=https://api.kraken.com
ALPHALENS_MARKET_DATA_TIMEOUT_SECONDS=10
ALPHALENS_HISTORY_BACKFILL_START=2010-01-01T00:00:00+00:00
ALPHALENS_HISTORY_BACKFILL_MAX_PAGES=100
ALPHALENS_DATABASE_URL=postgresql+asyncpg://alphalens_app:replace-with-url-encoded-secret@postgres:5432/alphalens
ALPHALENS_PREDICTION_API_MAX_REQUEST_BYTES=32768
