ALPHALENS_ENVIRONMENT=production
ALPHALENS_API_NAME="AlphaLens Live Prediction API"
ALPHALENS_API_HOST=0.0.0.0
# ALPHALENS_API_PORT is optional: when unset the platform-provided PORT is
# used, falling back to 8000. Set it only to override both.
#ALPHALENS_API_PORT=8000
# Certified BTCUSDT runtime starts live ingestion per process; keep 1 worker.
ALPHALENS_API_WORKERS=1
ALPHALENS_LOG_LEVEL=INFO
ALPHALENS_CORS_ALLOWED_ORIGINS=https://alphalens-navy.vercel.app
ALPHALENS_MARKET_DATA_BASE_URL=https://api.kraken.com
ALPHALENS_MARKET_DATA_TIMEOUT_SECONDS=10
ALPHALENS_HISTORY_BACKFILL_START=2010-01-01T00:00:00+00:00
ALPHALENS_HISTORY_BACKFILL_MAX_PAGES=100
# Managed PostgreSQL (postgresql+asyncpg scheme required). URL-encode secrets.
ALPHALENS_DATABASE_URL=postgresql+asyncpg://alphalens_app:replace-with-url-encoded-secret@your-managed-postgres-host:5432/alphalens
ALPHALENS_DATABASE_POOL_SIZE=10
ALPHALENS_DATABASE_MAX_OVERFLOW=20
ALPHALENS_DATABASE_POOL_TIMEOUT_SECONDS=30
# Managed Redis (redis:// or rediss://). Production requires a password.
ALPHALENS_REDIS_URL=redis://:replace-with-url-encoded-secret@your-managed-redis-host:6379/0
ALPHALENS_PREDICTION_API_MAX_REQUEST_BYTES=32768
ALPHALENS_METRICS_ENABLED=true
ALPHALENS_WORKER_CONCURRENCY=2
ALPHALENS_WORKER_POLL_SECONDS=1
ALPHALENS_WORKER_MAX_RETRIES=3
