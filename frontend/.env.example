ALPHALENS_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ALPHALENS_API_BASE_URL=http://127.0.0.1:8000

# The local_stack operator command sets these explicitly and generates the
# access token in a mode-600 private runtime.env file. Do not commit a token.
ALPHALENS_LOCAL_ONLY=false
NEXT_PUBLIC_ALPHALENS_LOCAL_ONLY=false

# Clerk development application publishable key. Safe for browser use.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
